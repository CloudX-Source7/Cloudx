@model CloudX.AzureConnection.DTOs.AzureConnectionPageViewModel

@{
    ViewData["Title"] = "Select Azure Subscription";
}

<div class="container py-5">
    <div class="mb-5">
        <span class="text-primary fw-semibold small">
            CLOUDX / AZURE CONNECTION
        </span>
        <h1 class="fw-bold mt-2">Select a subscription</h1>
        <p class="text-secondary">
            Choose the Azure subscription CloudX should use for
            resource discovery and security monitoring.
        </p>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h5 class="fw-semibold mb-1">Azure account</h5>
                    <p class="text-secondary mb-0">
                        @(Model.IsAzureAuthorized
                            ? "Microsoft Azure is connected."
                            : "Connect your Microsoft Azure account to continue.")
                    </p>
                </div>

                @if (Model.IsAzureAuthorized)
                {
                    <span class="badge text-bg-success">Authorized</span>
                }
                else
                {
                    <a asp-controller="AzureConnection"
                       asp-action="Connect"
                       class="btn btn-primary">
                        Connect Azure
                    </a>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.TenantId))
            {
                <hr />
                <div class="small text-secondary">Tenant ID</div>
                <code>@Model.TenantId</code>
            }
        </div>
    </div>

    @if (Model.IsAzureAuthorized)
    {
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <div>
                <h4 class="fw-semibold mb-1">Available subscriptions</h4>
                <p class="text-secondary mb-0">
                    Select a subscription to continue.
                </p>
            </div>

            <a asp-controller="AzureConnection"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Manage connections
            </a>
        </div>

        @if (Model.Connections == null || !Model.Connections.Any())
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <h5>No saved subscriptions</h5>
                    <p class="text-secondary">
                        Add an Azure subscription before selecting one.
                    </p>
                    <a asp-controller="AzureConnection"
                       asp-action="Index"
                       class="btn btn-primary">
                        Add subscription
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var connection in Model.Connections)
                {
                    <div class="col-12 col-lg-6">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="rounded-3 bg-primary-subtle text-primary p-3">
                                        <span class="fw-bold">AZ</span>
                                    </div>

                                    <div class="flex-grow-1">
                                        <h5 class="fw-semibold mb-2">
                                            Azure subscription
                                        </h5>

                                        <div class="small text-secondary mb-1">
                                            Subscription ID
                                        </div>

                                        <code class="text-break">
                                            @connection.SubscriptionId
                                        </code>
                                    </div>
                                </div>

                                <hr />

                                <form asp-controller="AzureConnection"
                                      asp-action="SelectSubscription"
                                      method="post">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="subscriptionId"
                                           value="@connection.SubscriptionId" />

                                    <button type="submit"
                                            class="btn btn-primary w-100">
                                        Select this subscription
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>
