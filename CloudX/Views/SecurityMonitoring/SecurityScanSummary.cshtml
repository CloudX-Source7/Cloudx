@model List<CloudX.SecurityMonitoring.UniversalRuleSupport.UniversalResultDto>

@{
    var category =
        ViewData["ScanCategory"]?.ToString()
        ?? "🚨";

    var categoryDescription =
        ViewData["ScanDescription"]?.ToString()
        ?? "CloudX scanned the Azure environment for security risks.";

    ViewData["Title"] =
        $"{category} Security Scan";

    var riskResults =
        Model?
            .Where(x =>
                string.Equals(
                    x.Status,
                    "Risk",
                    StringComparison.OrdinalIgnoreCase))
            .ToList()
        ?? new List<CloudX.SecurityMonitoring.UniversalRuleSupport.UniversalResultDto>();

    var noRiskCount =
        Model?.Count(x =>
            string.Equals(
                x.Status,
                "NoRisk",
                StringComparison.OrdinalIgnoreCase))
        ?? 0;

    var notEvaluatedCount =
        Model?.Count(x =>
            string.Equals(
                x.Status,
                "NotEvaluated",
                StringComparison.OrdinalIgnoreCase))
        ?? 0;

    var totalChecks =
        Model?.Count ?? 0;

    var totalRisks =
        riskResults.Count;

    var highRisks =
        riskResults.Count(x =>
            string.Equals(
                x.Finding?.Severity,
                "High",
                StringComparison.OrdinalIgnoreCase));

    var mediumRisks =
        riskResults.Count(x =>
            string.Equals(
                x.Finding?.Severity,
                "Medium",
                StringComparison.OrdinalIgnoreCase));

    var lowRisks =
        riskResults.Count(x =>
            string.Equals(
                x.Finding?.Severity,
                "Low",
                StringComparison.OrdinalIgnoreCase));
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @category Security Scan
    </title>

    <style>

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                padding: 0;
                font-family: Arial, Helvetica, sans-serif;
                background: #ffffff;
                color: #111827;
            }

            .scan-page {
                max-width: 1450px;
                margin: 0 auto;
                padding: 42px 32px 70px;
            }

            /* HEADER */

            .scan-header {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                margin-bottom: 45px;
            }

            .header-content h1 {
                margin: 0 0 10px;
                font-size: 40px;
                font-weight: 700;
                color: #050505;
            }

            .header-content p {
                margin: 0;
                font-size: 18px;
                line-height: 1.5;
                color: #64748b;
            }

            .header-icon {
                font-size: 55px;
                line-height: 1;
                padding-right: 10px;
            }

            /* SUMMARY */

            .summary-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 20px;
                margin-bottom: 42px;
            }

            .summary-card {
                background: #ffffff;
                border: 1px solid #e2e8f0;
                border-radius: 15px;
                padding: 25px;
            }

            .summary-label {
                margin-bottom: 10px;
                font-size: 16px;
                color: #64748b;
            }

            .summary-number {
                font-size: 32px;
                font-weight: 700;
                color: #050505;
            }

            /* RISK LIST */

            .risk-list {
                display: flex;
                flex-direction: column;
                gap: 18px;
            }

            .risk-card {
                display: block;
                padding: 27px;
                background: #ffffff;
                border: 1px solid #e2e8f0;
                border-radius: 15px;
                text-decoration: none;
                color: inherit;
                transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
            }

                .risk-card:hover {
                    transform: translateY(-2px);
                    border-color: #cbd5e1;
                    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
                }

            /* RISK HEADER */

            .risk-top {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                gap: 20px;
                margin-bottom: 12px;
            }

            .risk-title {
                margin: 0;
                font-size: 22px;
                font-weight: 700;
                color: #111827;
            }

            /* SEVERITY */

            .severity {
                flex-shrink: 0;
                padding: 7px 13px;
                border-radius: 20px;
                font-size: 13px;
                font-weight: 700;
            }

            .severity-high {
                background: #fee2e2;
                color: #dc2626;
            }

            .severity-medium {
                background: #fef3c7;
                color: #b45309;
            }

            .severity-low {
                background: #dcfce7;
                color: #15803d;
            }

            /* DESCRIPTION */

            .risk-description {
                margin: 0 0 20px;
                font-size: 17px;
                line-height: 1.6;
                color: #64748b;
            }

            /* RESOURCE INFORMATION */

            .risk-meta {
                display: flex;
                flex-wrap: wrap;
                gap: 22px;
                margin-bottom: 22px;
            }

            .risk-meta-item {
                font-size: 14px;
                color: #64748b;
            }

                .risk-meta-item strong {
                    color: #111827;
                }

            /* LINK */

            .finding-link {
                color: #2563eb;
                font-size: 15px;
                font-weight: 700;
            }

            /* NOT EVALUATED */

            .not-evaluated-list {
                display: flex;
                flex-direction: column;
                gap: 18px;
                margin-top: 30px;
            }

            .not-evaluated-card {
                padding: 25px;
                background: #f8fafc;
                border: 1px solid #cbd5e1;
                border-radius: 15px;
            }

            .not-evaluated-title {
                margin: 0 0 10px;
                font-size: 20px;
                font-weight: 700;
                color: #334155;
            }

            .not-evaluated-description {
                margin: 0 0 15px;
                line-height: 1.6;
                color: #64748b;
            }

            .not-evaluated-meta {
                display: flex;
                flex-wrap: wrap;
                gap: 22px;
                font-size: 14px;
                color: #64748b;
            }

                .not-evaluated-meta strong {
                    color: #334155;
                }

            /* NO RESULTS */

            .no-results {
                padding: 55px 30px;
                text-align: center;
                background: #f8fafc;
                border: 1px solid #cbd5e1;
                border-radius: 15px;
            }

                .no-results h2 {
                    margin: 0 0 12px;
                    font-size: 28px;
                    color: #111827;
                }

                .no-results p {
                    margin: 0;
                    font-size: 17px;
                    color: #64748b;
                }

            /* RESPONSIVE */

            @@media (max-width: 1000px) {

                .summary-grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @@media (max-width: 700px) {

                .scan-page {
                    padding: 30px 18px 50px;
                }

                .scan-header {
                    flex-direction: column;
                    gap: 20px;
                }

                .header-content h1 {
                    font-size: 30px;
                }

                .header-content p {
                    font-size: 16px;
                }

                .summary-grid {
                    grid-template-columns: 1fr;
                }

                .risk-top {
                    flex-direction: column;
                }

                .risk-meta,
                .not-evaluated-meta {
                    flex-direction: column;
                    gap: 8px;
                }
            }

    </style>

</head>

<body>

    <div class="scan-page">

        <!-- HEADER -->

        <div class="scan-header">

            <div class="header-content">

                <h1>
                    @category Security Scan
                </h1>

                <p>
                    @categoryDescription
                </p>

            </div>

            <div class="header-icon">
                🛡️
            </div>

        </div>

        <!-- SUMMARY -->

        <div class="summary-grid">

            <div class="summary-card">

                <div class="summary-label">
                    Total Checks
                </div>

                <div class="summary-number">
                    @totalChecks
                </div>

            </div>

            <div class="summary-card">

                <div class="summary-label">
                    🔴 Risks
                </div>

                <div class="summary-number">
                    @totalRisks
                </div>

            </div>

            <div class="summary-card">

                <div class="summary-label">
                    🟢 No Risk
                </div>

                <div class="summary-number">
                    @noRiskCount
                </div>

            </div>

            <div class="summary-card">

                <div class="summary-label">
                    ⚪ Not Evaluated
                </div>

                <div class="summary-number">
                    @notEvaluatedCount
                </div>

            </div>

        </div>

        <!-- RISK SEVERITY SUMMARY -->
        @if (totalRisks > 0)
        {

            <div class="summary-grid">

                <div class="summary-card">

                    <div class="summary-label">
                        High Risk
                    </div>

                    <div class="summary-number">
                        @highRisks
                    </div>

                </div>

                <div class="summary-card">

                    <div class="summary-label">
                        Medium Risk
                    </div>

                    <div class="summary-number">
                        @mediumRisks
                    </div>

                </div>

                <div class="summary-card">

                    <div class="summary-label">
                        Low Risk
                    </div>

                    <div class="summary-number">
                        @lowRisks
                    </div>

                </div>

            </div>

        }

        <!-- RISKS -->
        @if (riskResults.Any())
        {

            <div class="risk-list">

                @foreach (var result in riskResults)
                {

                    var finding = result.Finding;

                    if (finding == null)
                    {
                        continue;
                    }

                    var controllerName =
                        finding.Category switch
                        {
                            "Misconfiguration"
                                => "Misconfiguration",

                            "PublicExposure"
                                => "PublicExposure",

                            "IdentityAccess"
                                => "IdentityAccess",

                            "Encryption"
                                => "Encryption",

                            "NetworkFirewall"
                                => "NetworkFirewall",

                            "StorageDatabase"
                                => "StorageDatabase",

                            _ => "SecurityScan"
                        };

                    var severityClass =
                        finding.Severity?.ToLowerInvariant()
                        switch
                        {
                            "high"
                                => "severity-high",

                            "medium"
                                => "severity-medium",

                            "low"
                                => "severity-low",

                            _ => ""
                        };

                    <a class="risk-card"
                       href="@Url.Action(
                           finding.Rule,
                           controllerName)">

                        <div class="risk-top">

                            <h2 class="risk-title">
                                @finding.Title
                            </h2>

                            <span class="severity @severityClass">

                                @finding.Severity

                            </span>

                        </div>

                        <p class="risk-description">

                            @finding.Description

                        </p>

                        <div class="risk-meta">

                            <div class="risk-meta-item">

                                <strong>
                                    Resource:
                                </strong>

                                @finding.ResourceName

                            </div>

                            <div class="risk-meta-item">

                                <strong>
                                    Type:
                                </strong>

                                @finding.ResourceType

                            </div>

                            <div class="risk-meta-item">

                                <strong>
                                    Rule:
                                </strong>

                                @finding.Rule

                            </div>

                        </div>

                        <div class="finding-link">

                            View security finding →

                        </div>

                    </a>

                }

            </div>

        }
        else
        {

            <div class="no-results">

                <h2>
                    No Security Risks Found
                </h2>

                <p>
                    CloudX did not detect any security risks
                    in the evaluated checks.
                </p>

            </div>

        }

        <!-- NOT EVALUATED -->
        @if (notEvaluatedCount > 0)
        {

            <div class="not-evaluated-list">

                @foreach (var result in Model.Where(x =>
                    string.Equals(
                        x.Status,
                        "NotEvaluated",
                        StringComparison.OrdinalIgnoreCase)))
                {

                    <div class="not-evaluated-card">

                        <h2 class="not-evaluated-title">

                            ⚪ @result.Rule

                        </h2>

                        <p class="not-evaluated-description">

                            @(
                                string.IsNullOrWhiteSpace(result.Reason)
                                    ? "CloudX could not evaluate this rule."
                                    : result.Reason
                            )

                        </p>

                        <div class="not-evaluated-meta">

                            <div>

                                <strong>
                                    Resource:
                                </strong>

                                @result.ResourceName

                            </div>

                            <div>

                                <strong>
                                    Type:
                                </strong>

                                @result.ResourceType

                            </div>

                        </div>

                    </div>

                }

            </div>

        }

    </div>

</body>

</html>