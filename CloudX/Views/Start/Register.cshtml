@{
    Layout = null;
    ViewData["Title"] = "Register - CloudX";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - CloudX</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
            background: #f5f8fc;
            color: #172033;
        }

        .card {
            width: 500px;
            padding: 42px;
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 20px 50px rgba(30, 50, 90, 0.10);
        }

        .brand {
            color: #4169e1;
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 30px;
        }

        h1 {
            margin: 0 0 8px;
            font-size: 32px;
        }

        .subtitle {
            color: #68758b;
            margin: 0 0 30px;
            line-height: 1.5;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
        }

        input {
            width: 100%;
            padding: 14px;
            margin-bottom: 18px;
            border: 1px solid #d7dfeb;
            border-radius: 10px;
            font-size: 15px;
            outline: none;
        }

        input:focus {
            border-color: #4169e1;
        }

        .password-wrapper {
            position: relative;
            margin-bottom: 18px;
        }

        .password-wrapper input {
            margin-bottom: 0;
            padding-right: 58px;
        }

        .toggle-password {
            position: absolute;
            top: 50%;
            right: 12px;
            transform: translateY(-50%);
            width: auto;
            padding: 4px;
            margin: 0;
            border: 0;
            background: transparent;
            color: #68758b;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        .toggle-password:hover {
            background: transparent;
            color: #4169e1;
        }

        button {
            width: 100%;
            padding: 14px;
            border: 0;
            border-radius: 10px;
            background: #4169e1;
            color: #ffffff;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.2s;
        }

        button:hover:not(:disabled) {
            background: #3157cf;
        }

        button:disabled {
            opacity: 0.75;
            cursor: not-allowed;
        }

        .spinner {
            width: 18px;
            height: 18px;
            border: 2px solid rgba(255, 255, 255, 0.4);
            border-top-color: #ffffff;
            border-radius: 50%;
            display: inline-block;
            vertical-align: middle;
            animation: spin 0.7s linear infinite;
            margin-right: 8px;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .otp-section {
            display: none;
            margin-top: 28px;
            padding-top: 28px;
            border-top: 1px solid #e1e6ef;
        }

        .otp-section.show {
            display: block;
            animation: reveal 0.3s ease;
        }

        @@keyframes reveal {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .otp-info {
            margin: 0 0 18px;
            color: #68758b;
            font-size: 14px;
            line-height: 1.5;
        }

        .message {
            display: none;
            margin-top: 16px;
            padding: 12px;
            border-radius: 8px;
            font-size: 14px;
            line-height: 1.4;
        }

        .success {
            background: #eaf8ef;
            color: #198754;
        }

        .error {
            background: #fff0f0;
            color: #c62828;
        }

        .login {
            margin-top: 24px;
            text-align: center;
            color: #68758b;
        }

        .login a {
            color: #4169e1;
            text-decoration: none;
            font-weight: 600;
        }

        .login a:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>

    <div class="card">

        <div class="brand">
            CloudX
        </div>

        <h1>Create account</h1>

        <p class="subtitle">
            Create your CloudX account and verify your email.
        </p>

        <form id="registerForm">

            @Html.AntiForgeryToken()

            <label for="name">
                Name
            </label>

            <input
                type="text"
                id="name"
                name="Name"
                placeholder="Enter your name"
                autocomplete="name"
                required />

            <label for="email">
                Email
            </label>

            <input
                type="email"
                id="email"
                name="Email"
                placeholder="you@example.com"
                autocomplete="email"
                required />

            <label for="password">
                Password
            </label>

            <div class="password-wrapper">

                <input
                    type="password"
                    id="password"
                    name="Password"
                    placeholder="Minimum 8 characters"
                    minlength="8"
                    autocomplete="new-password"
                    required />

                <button
                    type="button"
                    class="toggle-password"
                    id="togglePassword">

                    Show

                </button>

            </div>

            <button
                type="submit"
                id="registerButton">

                Verify & Register

            </button>

        </form>

        <div
            id="registerMessage"
            class="message">
        </div>

        <div
            id="otpSection"
            class="otp-section">

            <p class="otp-info">
                We sent a 6-digit verification code to
                <strong id="otpEmail"></strong>.
                Enter it below to complete your registration.
            </p>

            <form id="otpForm">

                @Html.AntiForgeryToken()

                <label for="otp">
                    Verification Code
                </label>

                <input
                    type="text"
                    id="otp"
                    name="otp"
                    maxlength="6"
                    minlength="6"
                    inputmode="numeric"
                    autocomplete="one-time-code"
                    placeholder="Enter 6-digit OTP"
                    required />

                <button
                    type="submit"
                    id="otpButton">

                    Verify Email

                </button>

            </form>

            <div
                id="otpMessage"
                class="message">
            </div>

        </div>

        <div class="login">
            Already have an account?
            <a href="/LogReg/Login">
                Login
            </a>
        </div>

    </div>

    <script>

        const registerForm =
            document.getElementById("registerForm");

        const registerButton =
            document.getElementById("registerButton");

        const registerMessage =
            document.getElementById("registerMessage");

        const otpSection =
            document.getElementById("otpSection");

        const otpForm =
            document.getElementById("otpForm");

        const otpButton =
            document.getElementById("otpButton");

        const otpMessage =
            document.getElementById("otpMessage");

        const emailInput =
            document.getElementById("email");

        const otpEmail =
            document.getElementById("otpEmail");

        const password =
            document.getElementById("password");

        const togglePassword =
            document.getElementById("togglePassword");


        togglePassword.addEventListener(
            "click",
            function ()
            {
                if (password.type === "password")
                {
                    password.type = "text";
                    togglePassword.textContent = "Hide";
                }
                else
                {
                    password.type = "password";
                    togglePassword.textContent = "Show";
                }
            });


        function showMessage(
            element,
            message,
            success)
        {
            element.textContent =
                message;

            element.className =
                success
                    ? "message success"
                    : "message error";

            element.style.display =
                "block";
        }


        registerForm.addEventListener(
            "submit",
            async function (event)
            {
                event.preventDefault();

                registerButton.disabled =
                    true;

                registerButton.innerHTML =
                    '<span class="spinner"></span>Sending verification...';

                registerMessage.style.display =
                    "none";


                const formData =
                    new FormData(registerForm);


                try
                {
                    const response =
                        await fetch(
                            "/LogReg/Register",
                            {
                                method: "POST",
                                body: formData
                            });


                    const result =
                        await response.json();


                    if (result.success)
                    {
                        showMessage(
                            registerMessage,
                            result.message,
                            true);


                        otpEmail.textContent =
                            emailInput.value;


                        otpSection.classList.add(
                            "show");


                        registerButton.innerHTML =
                            "Verification email sent";


                        document
                            .getElementById("otp")
                            .focus();
                    }
                    else
                    {
                        showMessage(
                            registerMessage,
                            result.message,
                            false);


                        registerButton.disabled =
                            false;

                        registerButton.innerHTML =
                            "Verify & Register";
                    }
                }
                catch
                {
                    showMessage(
                        registerMessage,
                        "Unable to connect to the server.",
                        false);


                    registerButton.disabled =
                        false;

                    registerButton.innerHTML =
                        "Verify & Register";
                }
            });


        otpForm.addEventListener(
            "submit",
            async function (event)
            {
                event.preventDefault();

                otpButton.disabled =
                    true;

                otpButton.innerHTML =
                    '<span class="spinner"></span>Verifying...';

                otpMessage.style.display =
                    "none";


                const email =
                    emailInput.value.trim();

                const otp =
                    document
                        .getElementById("otp")
                        .value
                        .trim();


                const token =
                    otpForm.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    ).value;


                const formData =
                    new FormData();

                formData.append(
                    "email",
                    email);

                formData.append(
                    "otp",
                    otp);

                formData.append(
                    "__RequestVerificationToken",
                    token);


                try
                {
                    const response =
                        await fetch(
                            "/LogReg/VerifyOtp",
                            {
                                method: "POST",
                                body: formData
                            });


                    const result =
                        await response.json();


                    if (result.success)
                    {
                        showMessage(
                            otpMessage,
                            result.message,
                            true);


                        otpButton.innerHTML =
                            "Email Verified ✓";


                        setTimeout(
                            function ()
                            {
                                window.location.href =
                                    "/LogReg/Login";
                            },
                            1000);
                    }
                    else
                    {
                        showMessage(
                            otpMessage,
                            result.message,
                            false);


                        otpButton.disabled =
                            false;

                        otpButton.innerHTML =
                            "Verify Email";
                    }
                }
                catch
                {
                    showMessage(
                        otpMessage,
                        "Unable to connect to the server.",
                        false);


                    otpButton.disabled =
                        false;

                    otpButton.innerHTML =
                        "Verify Email";
                }
            });

    </script>

</body>
</html>