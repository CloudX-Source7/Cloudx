@{
    Layout = null;
    ViewData["Title"] = "Login - CloudX";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - CloudX</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: Arial, sans-serif;
                background: #f5f8fc;
                color: #172033;
            }

            .card {
                width: 420px;
                padding: 42px;
                background: #ffffff;
                border-radius: 20px;
                box-shadow: 0 20px 50px rgba(30, 50, 90, 0.10);
            }

            .brand {
                font-size: 24px;
                font-weight: 700;
                margin-bottom: 35px;
                color: #4169e1;
            }

            h1 {
                margin: 0 0 8px;
                font-size: 32px;
            }

            .subtitle {
                margin: 0 0 30px;
                color: #68758b;
                line-height: 1.5;
            }

            label {
                display: block;
                margin-bottom: 8px;
                font-weight: 600;
            }

            .password-wrapper {
                position: relative;
                margin-bottom: 20px;
            }

                .password-wrapper input {
                    margin-bottom: 0;
                    padding-right: 48px;
                }

            input {
                width: 100%;
                padding: 14px;
                margin-bottom: 20px;
                border: 1px solid #d7dfeb;
                border-radius: 10px;
                font-size: 15px;
                outline: none;
            }

                input:focus {
                    border-color: #4169e1;
                }

            .toggle-password {
                position: absolute;
                top: 50%;
                right: 12px;
                transform: translateY(-50%);
                width: auto;
                padding: 4px;
                margin: 0;
                border: 0;
                background: transparent;
                color: #68758b;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
            }

                .toggle-password:hover {
                    background: transparent;
                    color: #4169e1;
                }

            .login-button {
                width: 100%;
                padding: 14px;
                border: 0;
                border-radius: 10px;
                background: #4169e1;
                color: white;
                font-size: 16px;
                font-weight: 700;
                cursor: pointer;
                transition: 0.2s;
            }

                .login-button:hover:not(:disabled) {
                    background: #3157cf;
                }

                .login-button:disabled {
                    opacity: 0.75;
                    cursor: not-allowed;
                }

            .spinner {
                width: 18px;
                height: 18px;
                border: 2px solid rgba(255, 255, 255, 0.4);
                border-top-color: #ffffff;
                border-radius: 50%;
                display: inline-block;
                vertical-align: middle;
                animation: spin 0.7s linear infinite;
                margin-right: 8px;
            }

            @@keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }

            .message {
                display: none;
                margin-top: 18px;
                padding: 12px;
                border-radius: 8px;
                line-height: 1.4;
                font-size: 14px;
                background: #fff0f0;
                color: #c62828;
            }

            .register {
                margin-top: 24px;
                text-align: center;
                color: #68758b;
            }

                .register a {
                    color: #4169e1;
                    text-decoration: none;
                    font-weight: 600;
                }

                    .register a:hover {
                        text-decoration: underline;
                    }
    </style>
</head>

<body>

    <div class="card">

        <div class="brand">
            CloudX
        </div>

        <h1>Welcome back</h1>

        <p class="subtitle">
            Sign in to continue to your cloud intelligence dashboard.
        </p>

        <form id="loginForm">

            @Html.AntiForgeryToken()

            <label for="email">
                Email
            </label>

            <input type="email"
                   id="email"
                   name="Email"
                   placeholder="you@example.com"
                   autocomplete="email"
                   required />

            <label for="password">
                Password
            </label>

            <div class="password-wrapper">

                <input type="password"
                       id="password"
                       name="Password"
                       placeholder="Enter your password"
                       autocomplete="current-password"
                       required />

                <button type="button"
                        class="toggle-password"
                        id="togglePassword">

                    Show

                </button>

            </div>

            <button type="submit"
                    class="login-button"
                    id="loginButton">

                Login

            </button>

        </form>

        <div id="message"
             class="message">
        </div>

        <div class="register">
            Don't have an account?
            <a href="/LogReg/Register">
                Create account
            </a>
        </div>

    </div>

    <script>

            const form =
                document.getElementById("loginForm");

            const loginButton =
                document.getElementById("loginButton");

            const message =
                document.getElementById("message");

            const password =
                document.getElementById("password");

            const togglePassword =
                document.getElementById("togglePassword");


            togglePassword.addEventListener(
                "click",
                function ()
                {
                    if (password.type === "password")
                    {
                        password.type = "text";
                        togglePassword.textContent = "Hide";
                    }
                    else
                    {
                        password.type = "password";
                        togglePassword.textContent = "Show";
                    }
                });


            form.addEventListener(
                "submit",
                async function (event)
                {
                    event.preventDefault();

                    loginButton.disabled = true;

                    loginButton.innerHTML =
                        '<span class="spinner"></span>Signing in...';

                    message.style.display =
                        "none";


                    const formData =
                        new FormData(form);


                    try
                    {
                        const response =
                            await fetch(
                                "/LogReg/Login",
                                {
                                    method: "POST",
                                    body: formData
                                });


                        const result =
                            await response.json();


                        if (result.success)
                        {
                            window.location.href =
                                "/LogReg/ConnectAzure";

                            return;
                        }


                        message.textContent =
                            result.message ||
                            "Invalid email or password.";

                        message.style.display =
                            "block";


                        loginButton.disabled =
                            false;

                        loginButton.innerHTML =
                            "Login";
                    }
                    catch
                    {
                        message.textContent =
                            "Unable to connect to the server.";

                        message.style.display =
                            "block";


                        loginButton.disabled =
                            false;

                        loginButton.innerHTML =
                            "Login";
                    }
                });

    </script>

</body>
</html>